{
  "name": "react-native-audiosprites",
  "version": "0.6.2",
  "description": "audio sprites for react native ios, android and web",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli lib",
    "types:sync": "node scripts/generate-audio-types.mjs",
    "prebuild": "npm run types:sync",
    "prepare": "bob build",
    "release:alpha": "release-it --preRelease=alpha",
    "release": "release-it --only-version",
    "example": "yarn workspace react-native-audiosprites-example"
  },
  "keywords": [
    "react-native",
    "audio",
    "audiosprite",
    "audio-sprite",
    "sound-sprite",
    "sound-effects",
    "sfx",
    "game-audio",
    "playback",
    "optimization",
    "performance",
    "asset-bundling",
    "sound-management",
    "ios",
    "android",
    "web",
    "game",
    "music",
    "cross-platform"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qalqi/react-native-audiosprites.git"
  },
  "author": "qalqi <qalqi@qalqi.com> (https://github.com/qalqi)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qalqi/react-native-audiosprites/issues"
  },
  "homepage": "https://github.com/qalqi/react-native-audiosprites#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@evilmartians/lefthook": "^2.1.9",
    "@react-native-community/slider": "^5.2.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "^0.86.0",
    "@react-native/jest-preset": "^0.86.0",
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.17",
    "arktype": "^2.2.1",
    "baseline-browser-mapping": "latest",
    "commitlint": "^21.0.2",
    "del-cli": "^7.0.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "jest-runtime": "^29.7.0",
    "prettier": "^3.8.4",
    "react": "19.2.7",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.43.0",
    "release-it": "^20.2.0",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-audio-api": ">=0.12.2"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@3.6.1",
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "languages": "js",
    "type": "library",
    "version": "0.54.8"
  },
  "resolutions": {
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0"
  }
}
